#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// Google Maps SDK key ("Découvrir") — set via the MAPS_API_KEY env var at
// build time (xcodebuild -xcconfig or `flutter build ipa` picks up the
// shell environment). Empty by default; never commit a real key.
GOOGLE_MAPS_API_KEY = $(MAPS_API_KEY)
